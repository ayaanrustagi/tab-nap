{
  "manifest_version": 3,
  "name": "Tab Nap — Auto Suspend Idle Tabs",
  "short_name": "Tab Nap",
  "version": "1.0.1",
  "description": "Great Suspender–style auto tab suspender for modern Chrome. Native discard frees RAM. Whitelist sites, protect pinned/audio, wake all in one click."
  "homepage_url": "https://ayaanrustagi.github.io/tab-nap/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tab Nap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage", "alarms"]
}
